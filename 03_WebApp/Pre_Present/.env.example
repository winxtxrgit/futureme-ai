# FutureMe AI — optional server-side Anthropic configuration
#
# The demo runs without these variables. Route selection remains deterministic
# and executes in the browser. When no key is set, /api/explain and /api/chat
# use their deterministic offline fallbacks.

# Optional and server-side only. Never expose this value through NEXT_PUBLIC_*.
# When configured, /api/explain may reword fixed route reasons and /api/chat may
# send the bounded chat transcript to Anthropic.
# /api/chat now applies the in-process rate limit below, but that is a budget
# guard rather than authentication, and it counts per server instance. Before a
# funded key goes on a public deployment, still settle spend caps and the
# host's and provider's retention terms.
ANTHROPIC_API_KEY=

# Optional. Used by both endpoints when ANTHROPIC_API_KEY is present.
#
# Keep to a model that accepts `thinking: {type: "disabled"}` — the chat
# provider sends it, and Claude Fable 5 rejects that outright, so pointing this
# at Fable would make every request fail with a 400.
ANTHROPIC_MODEL=claude-sonnet-5

# Two ceilings per five minutes, because they protect different things.
#
# The request throttle protects the server. Everyone pays it, key or no key, so
# it is set where only a script can reach it: a person sends maybe six messages
# a minute, a script thousands a second, and 600 sits far above the first and
# far below the second. Hitting this one is a 429 — it does lock you out, which
# is why a whole computer lab behind one NAT address must never reach it.
CHAT_REQUEST_LIMIT_PER_CLIENT=600
CHAT_REQUEST_LIMIT_GLOBAL=6000

# The provider allowance protects the money, and is only spent by a call that
# is actually about to reach Anthropic. A blocked message, a question with no
# grounding, a malformed body, or a deployment with no key at all costs nothing
# against it.
#
# It can therefore be tight, because running out is not an error: the question
# is answered from the project data instead — the same answer this demo gives
# with no key configured. Lower the global one first if spend moves faster than
# expected; the per-client key comes from a header the caller writes, so it can
# be rotated for free.
CHAT_RATE_LIMIT_PER_CLIENT=30
CHAT_RATE_LIMIT_GLOBAL=600

# Both are counted in memory, so several instances enforce them several times
# over and a restart clears them. Replace the store in lib/chat/rate-limit.ts
# when that stops being good enough.

# The cumulative ceiling, which the two above cannot see.
#
# A five-minute window says nothing about a day. Staying politely inside 600
# calls per five minutes still amounts to roughly 172,000 calls in twenty-four
# hours — a bill in the thousands, reached without tripping anything, because
# nothing was counting the total.
#
# Counted per calendar day and calendar month in UTC, because that is how a bill
# is read. Tokens are counted from what the provider itself reports, so the cap
# tracks cost rather than call count. Setting a value to 0 means "no limit" on
# that measure, not "never call the provider" — a cap of zero is a configuration
# that looks like the feature is broken and gives no clue why.
#
# Running out is not an error: the chat answers from project data, the same
# answer this demo gives with no key at all.
CHAT_DAILY_CALL_CAP=1000
CHAT_DAILY_TOKEN_CAP=3000000
CHAT_MONTHLY_CALL_CAP=20000
CHAT_MONTHLY_TOKEN_CAP=60000000

# ⚠️ This is the second line of defence, not the first.
#
# It lives in this process: a restart clears it and several instances each keep
# their own, so on a platform that recycles containers the daily counter may not
# survive an hour. It is here to catch a runaway loop in the minutes before
# anyone looks at a dashboard, and to turn that into degraded answers instead of
# an invoice.
#
# The control that cannot be bypassed is the spend limit on the key itself, in
# the Anthropic Console. Set that before a funded key is ever deployed.
