# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามการใช้งาน:  cp .env.example .env
# ห้าม commit ไฟล์ .env จริงเข้า git (ใส่ .env ใน .gitignore)

# ---------- Embedding ----------
# โมเดล embedding หลายภาษา/ไทย (แนะนำ BAAI/bge-m3 หรือ intfloat/multilingual-e5-base)
EMBEDDING_MODEL=BAAI/bge-m3

# ---------- Vector store ----------
# โฟลเดอร์เก็บ Chroma (persistent)
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=thai_docs

# ---------- Retrieval ----------
TOP_K=4
# คะแนนความคล้ายขั้นต่ำ (cosine similarity 0-1). ต่ำกว่านี้ถือว่า "ไม่พบข้อมูล"
MIN_SCORE=0.30

# ---------- LLM backend ----------
# เลือก: "ollama" (local) หรือ "openai_compatible" (endpoint ที่รองรับ OpenAI API) หรือ "none" (แสดง context อย่างเดียว)
LLM_BACKEND=ollama

# --- ถ้าใช้ Ollama (local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# --- ถ้าใช้ OpenAI-compatible endpoint (เช่น vLLM/บริการภายใน) ---
# อย่าใส่ API key จริงลงในโค้ด ให้ใส่ที่นี่เท่านั้น
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# ---------- Generation ----------
TEMPERATURE=0.1
MAX_TOKENS=512
