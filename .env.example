# FutureMe AI — environment configuration
#
# The demo runs fully WITHOUT any of these variables.
# The decision engine is deterministic and executes in the browser.
# These only enable the OPTIONAL LLM explanation layer.

# Optional. When unset, the app uses deterministic template explanations.
ANTHROPIC_API_KEY=

# Optional. Model used for the explanation layer when a key is present.
ANTHROPIC_MODEL=claude-sonnet-5
